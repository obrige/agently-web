# agently-web — environment template.
# Copy to .env (or export the variables in your shell) before running
# `docker compose up`. All entries are optional.

# ----- Container image ------------------------------------------------ #
# Pull a pre-built image from GHCR instead of building locally.
# CI publishes to ghcr.io/<your-github-username>/agently-web:<tag> — just
# substitute your GitHub username. Common tags: latest, stable, v1.0.0, <sha>.
# AGENTLY_WEB_IMAGE=ghcr.io/alice/agently-web:latest

# ----- Data persistence (docker-compose.yml) -------------------------- #
# Volume name OR host path mounted at /data inside the container. The server
# stores five JSON files here (accounts.json, drafts.json, signatures.json,
# stars.json, contacts.json).
#
# Default (named volume, easiest):    AGENTLY_DATA_VOLUME=agently-data
# Bind mount to host directory:        AGENTLY_DATA_VOLUME=/srv/agently/data
# Bind mount on Windows:              AGENTLY_DATA_VOLUME=C:/Users/alice/agently-data
# Network mount (NAS/SMB):            AGENTLY_DATA_VOLUME=//nas.local/share/agently
#
# Use the same AGENTLY_DATA_VOLUME on a fresh host to migrate:
#   rsync -av old-host:/path/to/data/  new-host:/path/to/data/
# AGENTLY_DATA_VOLUME=agently-data

# ----- TLS overlay only (-f docker-compose.tls.yml) ------------------- #
# Public hostname (used for the Let's Encrypt certificate).
DOMAIN=mail.example.com

# Email used by Let's Encrypt to warn about certificate expiry.
ADMIN_EMAIL=[email protected]

# Volume name OR host path for Caddy's ACME account + issued certificates.
# Treat this as sensitive (the ACME private key lives here).
# CADDY_CERTS_VOLUME=caddy-data

# Host path for Caddy access / error logs.
# CADDY_LOGS_DIR=./caddy-logs